# Optional API Keys (The app works 100% offline via local Ollama or Extractive Synthesizer)
# If provided, enables cloud LLM generation backends:

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Host URL (Defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
